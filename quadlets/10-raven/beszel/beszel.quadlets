# FileName=beszel
[Pod]
PodName=beszel

---

# FileName=raven-beszel
[Container]
ContainerName=beszel
Image=docker.io/henrygd/beszel:latest
Pod=beszel.pod

Environment=TZ=Asia/Kolkata
NoNewPrivileges=yes
Volume=%h/data/beszel/data/:/beszel_data/:Z
Volume=%h/data/beszel/beszel_socket:/beszel_socket:z

PublishPort=8090:8090

---

# FileName=beszel-agent
[Install]
WantedBy=homelab.target

[Unit]
PartOf=homelab.target

[Container]
ContainerName=beszel-agent
Image=docker.io/henrygd/beszel-agent:latest
Network=host
Pod=beszel.pod

EnvironmentFile=.env
Environment=TZ=Asia/Kolkata
Environment=HUB_URL=http://127.0.0.1:8090
Environment=LISTEN=/beszel_socket/beszel.sock

SecurityLabelType=container_runtime_t
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=%h/data/beszel/beszel_socket:/beszel_socket:z

Volume=%h/data/beszel/beszel_agent_data/:/var/lib/beszel-agent/:Z
Volume=/hdd:/extra-filesystems/sda1:ro

AutoUpdate=registry
NoNewPrivileges=yes

[Service]
Restart=always
