# FileName=raven-linuxserverio-bazarr
[Container]
Image=lscr.io/linuxserver/bazarr:latest
ContainerName=bazarr
Environment=TZ=Asia/Kolkata
PublishPort=6767:6767
Volume=%h/data/bazarr/config:/config:Z
Volume=/hdd/Media/:/Media/:z

---

# FileName=raven-linuxserverio-flaresolverr
[Container]
ContainerName=flaresolverr
Environment=LOG_LEVEL=info LOG_HTML=false CAPTCHA_SOLVER=none TZ=Asia/Kolkata
Image=ghcr.io/flaresolverr/flaresolverr:latest
PublishPort=8191:8191
