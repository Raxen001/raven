# FileName=raven-linuxserverio-qbittorrent
[Container]
ContainerName=qbittorrent
Environment=TZ=Asia/Kolkata WEBUI_PORT=8080 TORRENTING_PORT=6881
Image=lscr.io/linuxserver/qbittorrent:latest
PublishPort=8080:8080
PublishPort=6881:6881
PublishPort=6881:6881/udp
Volume=%h/data/qbittorrent/:/config:Z

Volume=/hdd/Downloads/:/Downloads/:z
Volume=/hdd/Media/:/Media/:z

---

# FileName=raven-linuxserverio-radarr
[Container]
ContainerName=radarr
Environment=TZ=Asia/Kolkata
Image=lscr.io/linuxserver/radarr:latest
PublishPort=7878:7878
Volume=%h/data/radarr/:/config:Z
Volume=/hdd/Media/:/Media/:z

---

# FileName=raven-linuxserverio-sonarr
[Container]
