# vim: set ft=caddy
# reusable snippet
{
	log default {
		output stdout
		format json
	}

	log access_file {
		include http.log.access.main
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

(access_log) {
    log main
}

movie.{$DOMAIN} {
    import access_log
	reverse_proxy http://jellyfin:8096
}

rss.{$DOMAIN} {
    import access_log
	reverse_proxy http://miniflux:8080
}

voxabook.{$DOMAIN} {
    import access_log
	reverse_proxy http://host.docker.internal:9124
}

torrent.{$DOMAIN} {
    import access_log
	reverse_proxy http://qbittorrent:8080
}

speed.{$DOMAIN} {
    import access_log
	reverse_proxy http://speedtest:3000 {
		request_buffers 35MiB
		response_buffers 35MiB
		flush_interval -1
	}
}

