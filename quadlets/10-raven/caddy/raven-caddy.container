[Container]
ContainerName=caddy
Image=docker.io/library/caddy:latest
Environment=DOMAIN=raxen001.xyz

PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp

Volume=./Caddyfile:/etc/caddy/Caddyfile:z
Volume=%h/.cache/caddy/access.log:/var/log/caddy/access.log:Z

Volume=caddy_data:/data:z
Volume=caddy_config:/config:z
