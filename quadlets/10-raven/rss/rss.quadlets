#FileName=rss
[Pod]
HostName=miniflux
NetworkAlias=miniflux

---

#FileName=raven-miniflux
[Unit]
After=raven-miniflux-database.service
Requires=raven-miniflux-database.service

[Container]
ContainerName=miniflux
Image=quay.io/miniflux/miniflux:latest
Pod=rss.pod
Environment=RUN_MIGRATIONS=1
EnvironmentFile=.env
PublishPort=9191:8080

---

#FileName=raven-miniflux-database
[Container]
ContainerName=miniflux-database
Image=docker.io/library/postgres:18
Pod=rss.pod
Volume=%h/data/miniflux/db/:/var/lib/postgresql/:Z
EnvironmentFile=.env
