movie.{$DOMAIN} {
    import access_log
	reverse_proxy jellyfin:8096
}

rss.{$DOMAIN} {
    import access_log
	reverse_proxy miniflux:8080
}

voxabook.{$DOMAIN} {
    import access_log
	reverse_proxy host.docker.internal:9124
}

torrent.{$DOMAIN} {
    import access_log
	reverse_proxy qbittorrent:8080
}

speed.{$DOMAIN} {
    import access_log
	reverse_proxy speedtest:3000 {
		request_buffers 35MiB
		response_buffers 35MiB
		flush_interval -1
	}
}

home.{$DOMAIN} {
    import access_log
	reverse_proxy homarr:7575
}

