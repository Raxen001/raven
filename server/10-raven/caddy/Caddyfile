# vim: set ft=caddy

{
	log default {
		output stdout
		format json
	}

	log access_file {
		include http.log.access.main
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

# reusable snippet
(access_log) {
    log main
}

(tailscale_only) {
    @denied not remote_ip 100.110.205.92 fd7a:115c:a1e0::2134:cd5c/128
    redir @denied https://raxen001.xyz
}

